# Coverage gate (agent-harness-platform R14.3). Run through scripts/coverage.sh.
[run]
branch = True
parallel = True
patch = subprocess
data_file = build/.coverage
include =
    */scripts/harness_validator/*
    */scripts/harness_cli/*
    */harness/core/*
omit =
    */__main__.py
    */tests/*

[paths]
# Tests copy the template to a temp directory and run hooks there; map those paths back.
core =
    harness/core
    */harness/core
validator =
    scripts/harness_validator
    */scripts/harness_validator
cli =
    scripts/harness_cli
    */scripts/harness_cli

[report]
show_missing = True
skip_covered = True
