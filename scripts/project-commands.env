# Project lint and test commands, used by scripts/lint.sh, scripts/test.sh,
# the Quality_Hook (PostFileSave), and the PostTaskExec hook.
# Format: KEY="value" lines only. This file is read as data, not sourced.
# Replace each placeholder with your command, or set it to "" to skip it.
#
# LINT_FILE_COMMAND  lints one file. The file path is appended as one argument.
#                    Example: ruff check
# TEST_FILE_COMMAND  runs one test file once (single-run mode, no watch).
#                    The file path is appended as one argument.
#                    Example: npx vitest --run   or   python3 -m pytest -q
# TEST_COMMAND       runs the whole test suite once (single-run mode).
#                    Example: npm test -- --run   or   python3 -m pytest -q
LINT_FILE_COMMAND="{{LINT_FILE_COMMAND}}"
TEST_FILE_COMMAND="{{TEST_FILE_COMMAND}}"
TEST_COMMAND="{{TEST_COMMAND}}"
