{
  "schema": 1,
  "harness_version": "0.5.0",
  "agents": {
    "kiro": {"enabled": true},
    "claude-code": {"enabled": false},
    "cursor": {"enabled": false},
    "copilot": {"enabled": false}
  },
  "agents_md": false,
  "guidance": ["harness/guidance/*.md"],
  "guards": {
    "destructive": {"enabled": true},
    "risky": {"enabled": true},
    "prompt_secrets": {"enabled": true}
  },
  "quality": {"on_save": true, "post_task": true, "stop_validate": true, "session_start": true},
  "mcp": {
    "aws-docs": {
      "package": "awslabs.aws-documentation-mcp-server",
      "version": "1.2.6",
      "args": [],
      "env": {"FASTMCP_LOG_LEVEL": "ERROR", "AWS_DOCUMENTATION_PARTITION": "aws"},
      "disabled": false,
      "auto_approve": ["read_documentation", "search_documentation", "recommend"]
    },
    "fetch": {
      "package": "mcp-server-fetch",
      "version": "2026.11.18",
      "args": [],
      "disabled": false,
      "auto_approve": []
    },
    "git": {
      "package": "mcp-server-git",
      "version": "2026.11.18",
      "args": ["--repository", "."],
      "disabled": false,
      "auto_approve": ["git_status", "git_diff_unstaged", "git_diff_staged", "git_diff", "git_log", "git_show", "git_branch"]
    }
  }
}
