{
  "type": "object",
  "required": ["schema", "harness_version", "agents", "guidance", "guards", "quality", "mcp"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "harness_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kiro": {"$ref": "agent"},
        "claude-code": {"$ref": "agent"},
        "cursor": {"$ref": "agent"},
        "copilot": {"$ref": "agent"}
      }
    },
    "agents_md": {"type": "boolean"},
    "guidance": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^harness/guidance/[^/]*$"}},
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destructive": {"$ref": "agent"},
        "risky": {"$ref": "agent"},
        "prompt_secrets": {"$ref": "agent"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_save": {"type": "boolean"},
        "post_task": {"type": "boolean"},
        "stop_validate": {"type": "boolean"},
        "session_start": {"type": "boolean"}
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["package", "version", "args", "disabled", "auto_approve"],
        "additionalProperties": false,
        "properties": {
          "runner": {"type": "string", "enum": ["uvx", "npx"]},
          "package": {"type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9._/-]*$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "args": {"type": "array", "items": {"type": "string"}},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "disabled": {"type": "boolean"},
          "auto_approve": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "definitions": {
    "agent": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "maintainer": {"type": "string"}}
    }
  }
}
