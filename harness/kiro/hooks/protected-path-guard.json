{
  "version": "v1",
  "hooks": [
    {
      "name": "protected-path-guard",
      "trigger": "PreToolUse",
      "matcher": "^(fs_read|read_file|fs_write|write_file|delete_file|execute_bash|execute_pwsh|control_bash_process)$",
      "action": {
        "type": "command",
        "command": "sh .kiro/hooks/scripts/protected-path-guard.sh"
      },
      "timeout": 5,
      "description": "Blocks reads, writes and deletes of paths on harness/policy/protected-paths.txt (exit 2)."
    }
  ]
}
