#!/bin/sh
# Stop hook for Agents that support blocking a stop (Claude Code): require the
# Validation_Command to pass. Exit 2 with the tail of its output on stderr makes
# the Agent keep working. Never loops: when the Agent reports that a stop hook
# already ran (stop_hook_active), it lets the Agent stop.
dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 0
root=$(CDPATH='' cd -- "$dir/../.." && pwd) || exit 0
input=$(cat)
case $input in
  *'"stop_hook_active": true'* | *'"stop_hook_active":true'*) exit 0 ;;
esac
[ -x "$root/scripts/validate.sh" ] || [ -f "$root/scripts/validate.sh" ] || exit 0
out=$(cd "$root" && sh scripts/validate.sh 2>&1)
rc=$?
if [ "$rc" -ne 0 ]; then
  printf 'scripts/validate.sh exited with code %s. Fix the problems below, then run it again before finishing.\n' "$rc" >&2
  printf '%s\n' "$out" | tail -n 30 >&2
  exit 2
fi
exit 0
