#!/bin/sh
# SessionStart hook: print the git branch and uncommitted file count as context.
# Always exits 0, even when python3 is missing.
dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 0
command -v python3 >/dev/null 2>&1 || { echo "Git information unavailable: python3 not found"; exit 0; }
exec python3 -I "$dir/../core/session_info.py"
