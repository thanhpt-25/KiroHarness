          "paths": [
            "notebook_path"
          ]
        },
        "WebFetch": {
          "category": "web",
          "url": "url"
        }
      },
      "tool_prefix_map": {
        "mcp__": "mcp"
      },
      "mcp": {
        "path": ".mcp.json",
        "root_key": "mcpServers"
      },
      "permissions": {
        "path": ".claude/settings.json",
        "key": "permissions",
        "rules": [
          "allow",
          "ask",
          "deny"
        ]
      },
      "hooks_file": ".claude/settings.json",
      "protection": {
        "destructive": "enforced",
        "risky": "enforced",
        "prompt_secrets": "enforced",
        "protected_paths": "enforced"
      },
      "gaps": [
        "Bash deny rules are prefix patterns and can be bypassed by rewriting a command; the hook is the stronger layer.",
        "on_save and post_task quality hooks are Kiro-specific and are not rendered for Claude Code."
      ],
      "hooks": true
    },
